# Port for the file service (dart_frog dev --port ${PORT})
PORT=8080

# Either a full connection string...
MONGODB_URI=mongodb://localhost:27017/pos_file
# ...or individual parts (used only when MONGODB_URI is empty):
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DATABASE=pos_file
# MONGO_USERNAME=
# MONGO_PASSWORD=

# Local folder used to store uploads (file-v3 kept this under public/ so
# files are also reachable as static assets).
UPLOAD_DIR=public/uploads

# Maximum accepted upload size in bytes (default 512 MB).
# MAX_UPLOAD_BYTES=536870912
