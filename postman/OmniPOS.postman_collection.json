                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"unit_price\": 5000}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products/{{productId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('price updated', () => pm.expect(pm.response.json().data.unit_price).to.eql(5000));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "13 Products setup-data (type/creator dropdowns)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/products/setup-data"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Part 4 — Ordering (cashier)",
      "item": [
        {
          "name": "14 Ordering products (types with nested products)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cashier/ordering/products"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has a product to sell', () => pm.expect(pm.response.json().data.some(t => t.products.length > 0)).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "15 Place order (2 x demo product)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cart\": \"{\\\"{{productId}}\\\": 2}\", \"platform\": \"Web\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cashier/ordering/order"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json().data;",
                  "pm.collectionVariables.set('orderOwnId', order.id);",
                  "pm.collectionVariables.set('receiptNumber', order.receipt_number);",
                  "pm.test('7-digit receipt number', () => pm.expect(order.receipt_number).to.match(/^\\d{7}$/));",
                  "pm.test('total = 2 x 5000', () => pm.expect(order.total_price).to.eql(10000));",
                  "pm.test('price snapshot', () => pm.expect(order.items[0].unit_price).to.eql(5000));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "16 Place order with empty cart (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cart\": \"{}\", \"platform\": \"Web\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cashier/ordering/order"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422 unprocessable', () => pm.response.to.have.status(422));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "17 My sales list",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cashier/sales?page=1&limit=10",
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('my new order is listed', () => pm.expect(pm.response.json().data.map(o => o.id)).to.include(pm.collectionVariables.get('orderOwnId')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "18 My sale detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cashier/sales/{{orderOwnId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('same receipt', () => pm.expect(pm.response.json().data.receipt_number).to.eql(pm.collectionVariables.get('receiptNumber')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
