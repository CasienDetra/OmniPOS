{
  "info": {
    "name": "OmniPOS — full API demo flow",
    "description": "Step-by-step end-to-end demo of the POS api (dart_frog + MongoDB). Run top to bottom with the collection runner or manually. Requires `docker compose up -d` from the POS repo root. Requests 29-32 clean up all data the flow creates; run them at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenCashier",
      "value": ""
    },
    {
      "key": "typeId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderOwnId",
      "value": ""
    },
    {
      "key": "receiptNumber",
      "value": ""
    },
    {
      "key": "testUserId",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenCashier}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Part 0 — Health",
      "item": [
        {
          "name": "00 Basic testing endpoint (public)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/testing/basic"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('success envelope', () => pm.expect(pm.response.json().success).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Part 1 — Auth",
      "item": [
        {
          "name": "01 Login as admin",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin@pos.local\", \"password\": \"admin123\", \"platform\": \"Web\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/account/auth/login"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().data.token;",
                  "pm.collectionVariables.set('tokenAdmin', token);",
                  "pm.test('token captured', () => pm.expect(token).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "02 Login as cashier",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"cashier@pos.local\", \"password\": \"cashier123\", \"platform\": \"Web\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/account/auth/login"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenCashier', pm.response.json().data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "03 Login with wrong password (expect 401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin@pos.local\", \"password\": \"nope\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/account/auth/login"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('generic message', () => pm.expect(pm.response.json().error).to.eql('Invalid credentials'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "04 Admin list without token (expect 401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/products"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "05 Cashier on admin route (expect 403)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/products"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Part 2 — Product types (admin)",
      "item": [
        {
          "name": "06 Create type",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Postman Demo {{$timestamp}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/types"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('typeId', pm.response.json().data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "07 List types",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/types?page=1&limit=10",
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('pagination present', () => pm.expect(body.pagination).to.be.an('object'));",
                  "// Fallback typeId if the create request hit a duplicate name:",
                  "if (!pm.collectionVariables.get('typeId')) {",
                  "  const demo = body.data.find(t => t.name.startsWith('Postman Demo'));",
                  "  if (demo) pm.collectionVariables.set('typeId', demo.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "08 Rename type",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Postman Demo updated\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/types/{{typeId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('renamed', () => pm.expect(pm.response.json().data.name).to.eql('Postman Demo updated'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Part 3 — Products (admin)",
      "item": [
        {
          "name": "09 Create product",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Postman Latte\", \"code\": \"PM{{$timestamp}}\", \"type\": \"{{typeId}}\", \"unit_price\": 4500}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('productId', pm.response.json().data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "10 List products (paginated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/products?page=1&limit=10",
              "query": [
                {
                  "key": "page",
