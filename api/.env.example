# POS API service configuration (copy to .env)
PORT=3000

# Either a full URI...
MONGODB_URI=mongodb://localhost:27017/pos
# ...or discrete parts (used when MONGODB_URI is empty):
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DATABASE=pos
# MONGO_USERNAME=
# MONGO_PASSWORD=
# Note: `docker compose up mongo` now starts MongoDB with authentication.
# For that database, leave MONGODB_URI empty and fill MONGO_USERNAME/
# MONGO_PASSWORD with the application user from the root .env, or use
# mongodb://<app-user>:<app-password>@localhost:27017/pos?authSource=pos.

# Secret used to sign JWT access tokens (change in production!)
JWT_SECRET=change-me-in-production

# Base URL of the POS file service
FILE_BASE_URL=http://localhost:8080

# QR payments. One gateway sits behind the payment routes at a time and
# PAYMENT_PROVIDER says which: cutluy (the default) or payway. A name that is
# neither leaves the payment routes answering 503 and says what was written, so
# a typo there cannot be mistaken for either gateway.
# PAYMENT_PROVIDER=cutluy
#
# CutLuy — https://cutluy.com. Takes ABA KHQR payments in USD and signs the
# notifications it posts, so a delivery can be proved to have come from it.
# Both values below are secrets: this file is a template, never commit a key.
# CUTLUY_API_KEY is CutLuy Dashboard -> API keys (starts with ck_live_ or
# ck_test_). Without it the service starts and payments answer 503.
# CUTLUY_BASE_URL=https://cutluy.com
# CUTLUY_API_KEY=
# The endpoint secret CutLuy signs its webhooks with, shown next to the callback
# URL in the dashboard. Empty means this deployment accepts no notification at
# all, which is right for a machine CutLuy cannot reach: polling still closes
# sales.
# CUTLUY_WEBHOOK_SECRET=
# How far a delivery's timestamp may stray from this clock, in seconds, before
# it is refused as a replay.
# CUTLUY_WEBHOOK_TOLERANCE_SECONDS=300
# The currency the shelf prices are in. CutLuy charges USD only, so a KHR shop
# has its cart converted before a code is asked for.
# CUTLUY_SHOP_CURRENCY=KHR
# Riel per dollar the shop banks at, e.g. 4100. A KHR shop cannot be charged in
# USD without it, and a rate is never guessed: 0 (unset) means payments stay
# switched off rather than misbilling every sale in one direction.
# CUTLUY_KHR_USD_RATE=
# How long a payment is treated as payable when CutLuy's answer carries no
# expiry of its own, in seconds. CutLuy's own expiry (~5 minutes) is used when
# it is present.
# CUTLUY_FALLBACK_EXPIRY_SECONDS=300
#
# ABA PayWay — https://developer.payway.com.kh. Leave PAYWAY_MERCHANT_ID and
# PAYWAY_API_KEY empty and the service starts with payments switched off (the
# payment routes answer 503), which is what a machine that has no sandbox keys
# yet should do. Register at
# https://sandbox.payway.com.kh/register-sandbox/ to get both. PayWay refuses
# callers it has not whitelisted, so the public address of this machine has to
# be whitelisted by the PayWay integration team first.
# PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# PAYWAY_MERCHANT_ID=
# PAYWAY_API_KEY=
# KHR or USD. KHR must be whole riel, at least 100.
# PAYWAY_CURRENCY=KHR
# How long a displayed QR stays payable, in minutes (PayWay allows 3 and up).
# PAYWAY_QR_LIFETIME_MINUTES=10
# Public HTTPS address PayWay posts payment notifications to, e.g.
# https://pos.example.kh/api/v1/payments/callback. Empty means the api polls
# the gateway instead — fine on a laptop, and the callback is only ever a
# hint to go and check because PayWay signs nothing.
# PAYWAY_CALLBACK_URL=
# Optional branded QR image variant (template1_color, template3_color, ...).
# PAYWAY_QR_IMAGE_TEMPLATE=
