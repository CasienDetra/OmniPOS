# Local environment — templates are committed as .env.example
.env
.env.local
.env.*.local
!.env.example

# Backup artifacts land on host disk under the default BACKUP_DIR; they are
# data, never source.
/backups/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
*.swp

# Logs
*.log

# Dart / pub artifacts (each package also carries a package-level ignore)
.dart_tool/
.packages
.pub-cache/
build/
coverage/

# Node tooling used for ad-hoc testing (newman, npm installs)
node_modules/

# Local demo / probe artifacts. Machine-specific scripts and the files they
# generate; never source.
/scripts/invoice.pdf
/scripts/live_demo.py
/scripts/payment_preview.html
/scripts/payment_qr.png
/scripts/test_all_routes.py
/scripts/test_payment_flow.py
